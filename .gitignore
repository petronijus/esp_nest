# Build output
build/

# Generated sdkconfig (use sdkconfig.defaults for version control)
sdkconfig
sdkconfig.old

# Secrets (WiFi credentials, API keys, etc.)
secrets.defaults

# Managed components (downloaded by ESP Component Manager)
managed_components/
dependencies.lock

# Host test build output (binaries; see test/host/Makefile)
test/host/build/

# macOS debug-symbol bundles produced by the host-test builds
test/host/*.dSYM/

# Editor/tooling caches (clangd index etc.)
.cache/

# Local node env for lv_font_conv (never commit)
.nodeenv/

# Private overlay (clone of esp_nest-private)
/private/

# ESPHome build state and secrets
esphome/**/.esphome/
esphome/**/secrets.yaml
__pycache__/
esphome/fallback/
esphome/**/compile*.log
