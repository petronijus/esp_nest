# Copy to secrets.defaults (gitignored) and fill in your values.
# sdkconfig-defaults syntax; loaded by the root CMakeLists.txt on top of
# sdkconfig.defaults. Re-run idf.py build after changing.
CONFIG_WIFI_SSID="your-ssid"
CONFIG_WIFI_PASSWORD="your-wifi-password"
CONFIG_MQTT_BROKER_URI="mqtt://192.0.2.10:1883"
CONFIG_MQTT_USERNAME="mqtt-user"
CONFIG_MQTT_PASSWORD="mqtt-password"

# Optional: external-device MQTT topics. Defaults (see main/Kconfig.projbuild)
# are generic; override here to match your own zigbee2mqtt / ESPHome entities.
#CONFIG_TOPIC_FAN="home/fan"
#CONFIG_TOPIC_LIGHTS="zigbee2mqtt/lights"
#CONFIG_TOPIC_STEREO_VOL="home/stereo/volume"
#CONFIG_TOPIC_BLINDS_PREFIX="blinds/cover"
#CONFIG_TOPIC_BLINDS_GROUP_A="group_a"
#CONFIG_TOPIC_BLINDS_GROUP_B="group_b"
#CONFIG_TOPIC_BLINDS_LABEL_A="A"
#CONFIG_TOPIC_BLINDS_LABEL_B="B"
