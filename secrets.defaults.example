# Copy to secrets.defaults (gitignored) and fill in your values.
# sdkconfig-defaults syntax; loaded by the root CMakeLists.txt on top of
# sdkconfig.defaults. Re-run idf.py build after changing.
CONFIG_WIFI_SSID="your-ssid"
CONFIG_WIFI_PASSWORD="your-wifi-password"
CONFIG_MQTT_BROKER_URI="mqtt://192.0.2.10:1883"
CONFIG_MQTT_USERNAME="mqtt-user"
CONFIG_MQTT_PASSWORD="mqtt-password"
